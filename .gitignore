# Dependencies
node_modules/
package-lock.json

# 运行时数据（用户知识资产，不随仓库分发）
*.db
*.db.tmp
knowledge.db
wiki/
logs/
snapshots/
data/
mustard-seeds/
metabolism-state.json

# 模型权重（setup-vectors.ps1 下载产物，约 22MB，可重建）
models/

# raw/：运行产物与用户文档不入库，但种子知识源 .md 随仓库分发（验收 C3 依赖）
raw/*
!raw/*.md
!raw/.gitkeep

# 本地配置（用 growth.config.example.js 作为模板）
src/growth.config.js

# 环境与密钥
.env
.env.local

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
