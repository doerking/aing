# Dependencies
node_modules/
package-lock.json

# 运行时数据（用户知识资产，不随仓库分发）
*.db
*.db.tmp
knowledge.db
raw/
wiki/
logs/
snapshots/
data/*
!data/component-registry.json
mustard-seeds/
metabolism-state.json

# 本地配置（用 growth.config.example.ts 作为模板）
src/growth.config.js

# 环境与密钥
.env
.env.local

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
models/

# Agent 中间产物（不入库）
.temp/

# M4 验证产物（可复现，不入库）
simulation/proof-*.json
simulation/skillopt-evidence.json
simulation/skillopt-online-evidence.json
simulation/last-run.json

# 会话入库运行态（2026-09-14 与版本化知识源分离）：入库产物 + WAL 缓冲 + 重复批次记录
# 不放进来每次入库都会让工作树变脏，sync-opt 换血会被「不 clean」拒绝
raw/inbox/
data/ingest-buffer.jsonl
data/ingest-duplicates.jsonl
